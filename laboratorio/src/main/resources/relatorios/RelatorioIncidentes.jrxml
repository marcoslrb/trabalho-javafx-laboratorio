    <property name="com.jaspersoft.studio.data.sql.tables" value=""/>
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="PostgreSQL Adapter"/>
    <parameter name="p_id_laboratorio" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
    </parameter>
    <queryString language="SQL">
        <![CDATA[SELECT 
            pm.hora_pedido, 
            p.nome AS pesquisador, 
            l.nome AS laboratorio, 
            pm.descricao
        FROM PEDIDO_MANUTENCAO pm
        JOIN RESERVA r ON pm.id_reserva = r.id
        JOIN PESQUISADOR p ON r.matricula_pesquisador = p.matricula
        JOIN LABORATORIO l ON r.id_laboratorio = l.id
        WHERE ($P{p_id_laboratorio} = -1 OR l.id = $P{p_id_laboratorio})
        ORDER BY pm.hora_pedido DESC]]>
    </queryString>
    <field name="hora_pedido" class="java.sql.Timestamp">
        <property name="com.jaspersoft.studio.field.name" value="hora_pedido"/>
        <property name="com.jaspersoft.studio.field.label" value="hora_pedido"/>
        <property name="com.jaspersoft.studio.field.tree.path" value="pedido_manutencao"/>
    </field>
    <field name="pesquisador" class="java.lang.String">
