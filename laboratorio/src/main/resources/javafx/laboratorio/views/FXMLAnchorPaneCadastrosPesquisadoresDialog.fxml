<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="300.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.laboratorio.controllers.FXMLAnchorPaneCadastrosPesquisadoresDialogController">
   <children>
      <GridPane layoutX="30.0" layoutY="25.0" prefHeight="200.0" prefWidth="360.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="175.0" minWidth="10.0" prefWidth="80.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="280.0" minWidth="10.0" prefWidth="280.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Matrícula" />
            <Label text="Nome" GridPane.rowIndex="1" />
            <Label text="E-mail" GridPane.rowIndex="2" />
            <Label text="CPF" GridPane.rowIndex="3" />
            <Label text="Telefone" GridPane.rowIndex="4" />
            <Label text="Status" GridPane.rowIndex="5" />
            
            <TextField fx:id="textFieldMatricula" GridPane.columnIndex="1" />
            <TextField fx:id="textFieldNome" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="textFieldEmail" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="textFieldCPF" promptText="Apenas números" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="textFieldTelefone" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <CheckBox fx:id="checkBoxSuspenso" mnemonicParsing="false" text="Pesquisador Suspenso" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </children>
      </GridPane>
      <Group layoutX="230.0" layoutY="250.0" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="30.0">
         <children>
            <Button fx:id="buttonConfirmar" mnemonicParsing="false" onAction="#handleButtonConfirmar" prefWidth="75.0" text="Confirmar" />
            <Button fx:id="buttonCancelar" layoutX="85.0" mnemonicParsing="false" onAction="#handleButtonCancelar" prefWidth="75.0" text="Cancelar" />
         </children>
      </Group>
   </children>
</AnchorPane>