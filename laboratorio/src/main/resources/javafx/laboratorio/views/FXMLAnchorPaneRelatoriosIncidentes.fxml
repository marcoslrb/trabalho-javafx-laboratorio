<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.laboratorio.controllers.FXMLAnchorPaneRelatoriosIncidentesController">
   <children>
      <Label layoutX="51.0" layoutY="52.0" text="Log de Incidentes e Impacto em Reservas">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label alignment="CENTER" layoutX="51.0" layoutY="127.0" maxWidth="457.0" prefHeight="36.0" prefWidth="457.0" text="Selecione um laboratório específico para filtrar os incidentes, ou selecione 'Todos os Laboratórios' para listar a totalidade dos registros." textFill="#7F8C8D" wrapText="true">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <VBox alignment="CENTER_LEFT" maxWidth="300.0" spacing="8.0" />
      <Label layoutX="51.0" layoutY="103.0" text="Filtrar por Laboratório:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="comboBoxLaboratorio" layoutX="51.0" layoutY="177.0" prefHeight="29.0" prefWidth="229.0" promptText="Selecione o laboratório..." />
      <Button fx:id="buttonVisualizar" layoutX="364.0" layoutY="241.0" mnemonicParsing="false" onAction="#handleButtonVisualizar" prefHeight="29.0" prefWidth="144.0" text="Gerar Relatório">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
