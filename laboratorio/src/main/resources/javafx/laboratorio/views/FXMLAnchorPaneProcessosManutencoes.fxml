<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!--
    Tela de Pedido de Manutenção
    
    LAYOUT:
    - Parte SUPERIOR: formulário de cadastro com 3 passos validados
    - Parte INFERIOR: TableView listando todos os pedidos registrados
    
    FLUXO VISUAL (da esquerda para direita, de cima para baixo):
    [1] Campo Matrícula + Botão "Validar Pesquisador" -> Label com nome
    [2] ComboBox Laboratório + Botão "Verificar Reserva" -> Label com info da reserva
    [3] TextArea Descrição
    [4] Botão "Registrar Pedido"
    [5] TableView com pedidos + Botão "Marcar Resolvido"
-->

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.laboratorio.controllers.FXMLAnchorPaneProcessosManutencoesController">
   <children>

      <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <!-- ======================================================= -->
            <!-- SEÇÃO DE FORMULÁRIO (parte superior)                     -->
            <!-- ======================================================= -->
            <TitledPane animated="false" collapsible="false" prefHeight="235.0" text="Novo Pedido de Manutenção" VBox.vgrow="NEVER">
               <content>
                  <GridPane hgap="10.0" style="-fx-padding: 10;" vgap="10.0">
                    <columnConstraints>
                      <!-- Coluna dos rótulos -->
                      <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="120.0" />
                      <!-- Coluna dos campos -->
                      <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="350.0" />
                      <!-- Coluna dos botões de validação -->
                      <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="180.0" />
                      <!-- Coluna dos labels de feedback -->
                      <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="80.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <!-- Linha 0: Matrícula do Pesquisador -->
                      <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                      <!-- Linha 1: Laboratório -->
                      <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                      <!-- Linha 2: Descrição -->
                      <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
                      <!-- Linha 3: Botão Registrar -->
                      <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>

                        <!-- LINHA 0: PASSO 1 - Pesquisador -->
                        <Label text="Matrícula:" GridPane.valignment="CENTER" />

                        <TextField fx:id="textFieldMatricula" promptText="Digite a matrícula (máx. 8 dígitos)" GridPane.columnIndex="1" />

                        <!-- Botão de validação do pesquisador -->
                        <Button fx:id="buttonValidarPesquisador" mnemonicParsing="false" onAction="#handleButtonValidarPesquisador" prefWidth="170.0" text="Validar Pesquisador" GridPane.columnIndex="2" />

                        <!-- Feedback: nome do pesquisador encontrado -->
                        <Label fx:id="labelNomePesquisador" text="" wrapText="true" GridPane.columnIndex="3" />

                        <!-- LINHA 1: PASSO 2 - Laboratório -->
                        <Label text="Laboratório:" GridPane.rowIndex="1" GridPane.valignment="CENTER" />

                        <!-- ComboBox: exibe o toString() do Laboratorio (que é o nome) -->
                        <ComboBox fx:id="comboBoxLaboratorio" prefHeight="26.0" prefWidth="188.0" promptText="Selecione o laboratório" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <!-- Botão de verificação da reserva -->
                        <Button fx:id="buttonVerificarReserva" mnemonicParsing="false" onAction="#handleButtonVerificarReserva" prefWidth="170.0" text="Verificar Reserva" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                        <!-- Feedback: info da reserva encontrada -->
                        <Label fx:id="labelInfoReserva" text="" wrapText="true" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <!-- LINHA 2: PASSO 3 - Descrição do problema -->
                        <Label text="Descrição:" GridPane.rowIndex="2" GridPane.valignment="TOP" />

                        <TextArea fx:id="textAreaDescricao" promptText="Descreva o problema encontrado no laboratório (máx. 500 caracteres)" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />

                        <!-- LINHA 3: Botão principal -->
                        <Button fx:id="buttonRegistrarPedido" mnemonicParsing="false" onAction="#handleButtonRegistrarPedido" prefWidth="250.0" style="-fx-font-weight: bold;" text="Registrar Pedido de Manutenção" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="3" />

                     </children>
                  </GridPane>
               </content>
            </TitledPane>

            <!-- ======================================================= -->
            <!-- SEÇÃO DE LISTAGEM (parte inferior)                       -->
            <!-- ======================================================= -->
            <TitledPane animated="false" collapsible="false" text="Pedidos de Manutenção Registrados" VBox.vgrow="ALWAYS">
               <content>
                  <AnchorPane>
                     <children>

                        <!-- TableView com todos os pedidos -->
                        <TableView fx:id="tableViewPedidos" layoutX="30.0" layoutY="14.0" prefHeight="245.0" prefWidth="708.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="4.0">
                          <columns>
                            <TableColumn fx:id="tableColumnPedidoId" prefWidth="50.0" text="ID" />
                            <TableColumn fx:id="tableColumnPedidoPesquisador" prefWidth="160.0" text="Pesquisador" />
                            <TableColumn fx:id="tableColumnPedidoLaboratorio" prefWidth="150.0" text="Laboratório" />
                            <TableColumn fx:id="tableColumnPedidoHora" prefWidth="130.0" text="Data/Hora" />
                            <TableColumn fx:id="tableColumnPedidoStatus" prefWidth="100.0" text="Status" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>

                        <!-- Botões de gerenciamento abaixo da tabela -->
                        <HBox spacing="10.0" AnchorPane.bottomAnchor="5.0" AnchorPane.rightAnchor="10.0">
                           <children>
                              <Button fx:id="buttonAlterarPedido" mnemonicParsing="false" onAction="#handleButtonAlterarPedido" prefWidth="150.0" text="Editar Selecionado" />
                              <Button fx:id="buttonRemoverPedido" mnemonicParsing="false" onAction="#handleButtonRemoverPedido" prefWidth="160.0" text="Remover Selecionado" />
                              <Button fx:id="buttonMarcarResolvido" mnemonicParsing="false" onAction="#handleButtonMarcarResolvido" prefWidth="180.0" style="-fx-font-weight: bold;" text="Marcar como Resolvido" />
                           </children>
                        </HBox>

                     </children>
                  </AnchorPane>
               </content>
            </TitledPane>

         </children>
      </VBox>

   </children>
</AnchorPane>
