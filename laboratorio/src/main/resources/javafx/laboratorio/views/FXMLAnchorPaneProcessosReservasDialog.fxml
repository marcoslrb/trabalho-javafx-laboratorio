<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="350.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.laboratorio.controllers.FXMLAnchorPaneProcessosReservasDialogController">
   <children>
      <GridPane layoutX="30.0" layoutY="30.0" prefHeight="240.0" prefWidth="390.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="189.0" minWidth="10.0" prefWidth="120.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="270.0" minWidth="10.0" prefWidth="270.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Pesquisador" />
            <Label text="Laboratório" GridPane.rowIndex="1" />
            <Label text="Início (Data/Hora)" GridPane.rowIndex="2" />
            <Label text="Término (Data/Hora)" GridPane.rowIndex="3" />
            <ComboBox fx:id="comboBoxReservaPesquisador" prefWidth="270.0" promptText="Selecione o pesquisador..." GridPane.columnIndex="1" />
            <ComboBox fx:id="comboBoxReservaLaboratorio" prefWidth="270.0" promptText="Selecione o laboratório..." GridPane.rowIndex="1" GridPane.columnIndex="1" />
            <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <DatePicker fx:id="datePickerDataInicio" prefWidth="150.0" />
                  <TextField fx:id="textFieldHoraInicio" prefWidth="100.0" promptText="HH:mm" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
               <children>
                  <DatePicker fx:id="datePickerDataFim" prefWidth="150.0" />
                  <TextField fx:id="textFieldHoraFim" prefWidth="100.0" promptText="HH:mm" />
               </children>
            </HBox>
         </children>
      </GridPane>
      <Button fx:id="buttonConfirmar" layoutX="260.0" layoutY="290.0" onAction="#handleButtonConfirmar" prefWidth="80.0" text="Confirmar" />
      <Button fx:id="buttonCancelar" layoutX="350.0" layoutY="290.0" onAction="#handleButtonCancelar" prefWidth="80.0" text="Cancelar" />
   </children>
</AnchorPane>